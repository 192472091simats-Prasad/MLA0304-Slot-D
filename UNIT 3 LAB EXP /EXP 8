import numpy as np
import random

# Environment: 4-way intersection
EPISODES = 2000
gamma = 0.9
lr_actor = 0.01
lr_critic = 0.05

# Traffic state: cars waiting in [N, S, E, W]
MAX_CARS = 10
ACTIONS = ["NS_GREEN", "EW_GREEN"]  # N/S green or E/W green

# Initialize actor and critic weights
actor_weights = np.random.randn(4, len(ACTIONS)) * 0.01
critic_weights = np.random.randn(4) * 0.01

def softmax(prefs):
    exp_prefs = np.exp(prefs - np.max(prefs))
    return exp_prefs / np.sum(exp_prefs)

def choose_action(state):
    prefs = np.dot(state, actor_weights)
    probs = softmax(prefs)
    action_idx = np.random.choice(len(ACTIONS), p=probs)
    return action_idx, probs

def step(state, action_idx):
    new_state = state.copy()
    reward = 0
    if action_idx == 0:  # NS green
        reward -= new_state[2] + new_state[3]  # E/W waiting cars penalty
        new_state[0] = max(0, new_state[0]-random.randint(1,3))
        new_state[1] = max(0, new_state[1]-random.randint(1,3))
    else:  # EW green
        reward -= new_state[0] + new_state[1]  # N/S waiting cars penalty
        new_state[2] = max(0, new_state[2]-random.randint(1,3))
        new_state[3] = max(0, new_state[3]-random.randint(1,3))
    # Random new cars arrive
    new_state += np.random.randint(0,2,4)
    reward -= np.sum(new_state)  # penalty for total waiting cars
    return np.clip(new_state,0,MAX_CARS), reward

# PPO-like training loop
for ep in range(EPISODES):
    state = np.random.randint(0,5,4)  # initial cars
    trajectory = []
    for t in range(10):
        action_idx, probs = choose_action(state)
        next_state, r = step(state, action_idx)
        trajectory.append((state, action_idx, r, probs))
        state = next_state
    # Compute returns and update actor/critic
    G = 0
    for s, a, r, probs in reversed(trajectory):
        G = r + gamma * G
        td_error = G - np.dot(s, critic_weights)
        critic_weights += lr_critic * td_error * s
        grad = np.zeros_like(actor_weights)
        for i in range(len(ACTIONS)):
            grad[:, i] = (1 if i==a else 0 - probs[i]) * s
        actor_weights += lr_actor * td_error * grad

# Extract final policy
state_test = np.array([3,2,4,1])
prefs = np.dot(state_test, actor_weights)
probs = softmax(prefs)
policy = {ACTIONS[i]: probs[i] for i in range(len(ACTIONS))}
print("\nTraffic Signal Policy Probabilities (PPO-like):")
for action, prob in policy.items():
    print(f"{action}: {prob:.2f}")

# Simulate a sequence of signal control
state = np.array([2,3,1,4])
print("\nTraffic Simulation (Cars waiting N,S,E,W) and chosen signals:")
for t in range(10):
    action_idx, _ = choose_action(state)
    print(f"Time {t}: State {state} -> Action {ACTIONS[action_idx]}")
    state, _ = step(state, action_idx)
