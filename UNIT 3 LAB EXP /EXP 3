import numpy as np
import random

# Environment setup
GRID_SIZE = 5
START = (0,0)
PACKING_STATION = (4,4)
SHELVES = [(0,4), (2,2), (3,0)]  # Items to pick
OBSTACLES = [(1,1), (2,3)]
ACTIONS = ["UP", "DOWN", "LEFT", "RIGHT"]
EPISODES = 2000

# PPO hyperparameters (simplified)
alpha = 0.01
gamma = 0.9
epsilon_clip = 0.2

# Initialize policy parameters (softmax preferences) and value function
theta = {}
V = {}
for i in range(GRID_SIZE):
    for j in range(GRID_SIZE):
        theta[(i,j)] = np.zeros(len(ACTIONS))
        V[(i,j)] = 0.0

# Softmax action selection
def softmax(state):
    prefs = theta[state]
    exp_prefs = np.exp(prefs - np.max(prefs))
    return exp_prefs / np.sum(exp_prefs)

def choose_action(state):
    probs = softmax(state)
    return np.random.choice(ACTIONS, p=probs)

# Move function
def move(state, action):
    x, y = state
    if action == "UP":
        x = max(0, x-1)
    elif action == "DOWN":
        x = min(GRID_SIZE-1, x+1)
    elif action == "LEFT":
        y = max(0, y-1)
    elif action == "RIGHT":
        y = min(GRID_SIZE-1, y+1)
    next_state = (x,y)
    if next_state in OBSTACLES:
        return state
    return next_state

# Reward function
def reward(state, picked):
    if state in OBSTACLES:
        return -5
    r = 0
    if state in SHELVES and state not in picked:
        r += 10  # pick item
    if state == PACKING_STATION and len(picked) == len(SHELVES):
        r += 20  # successful delivery
    r -= 1  # step cost
    return r

# Simplified PPO training
for ep in range(EPISODES):
    state = START
    picked = set()
    trajectory = []

    while True:
        action = choose_action(state)
        next_state = move(state, action)
        r = reward(next_state, picked)
        if next_state in SHELVES:
            picked.add(next_state)
        trajectory.append((state, action, r, next_state))
        state = next_state
        if state == PACKING_STATION and len(picked) == len(SHELVES):
            break
        if len(trajectory) > 50:
            break

    # Update value and policy (simplified PPO-like)
    G = 0
    for s, a, r, ns in reversed(trajectory):
        G = r + gamma * G
        td_error = G - V[s]
        V[s] += alpha * td_error
        a_idx = ACTIONS.index(a)
        probs = softmax(s)
        # PPO clipped update simplified
        theta[s][a_idx] += alpha * td_error * (1 - probs[a_idx])
        theta[s] = np.clip(theta[s], -5, 5)

# Extract final policy
policy = {}
for i in range(GRID_SIZE):
    for j in range(GRID_SIZE):
        s = (i,j)
        if s in OBSTACLES:
            policy[s] = "OBSTACLE"
        elif s in SHELVES:
            policy[s] = "SHELF"
        elif s == PACKING_STATION:
            policy[s] = "PACK"
        else:
            policy[s] = ACTIONS[np.argmax(theta[s])]

# Display policy
print("\nWarehouse Robot Policy (simplified PPO):")
for i in range(GRID_SIZE):
    for j in range(GRID_SIZE):
        print(f"{policy[(i,j)]:10}", end=" ")
    print()
